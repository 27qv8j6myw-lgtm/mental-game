<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 카카오·구글 로그인 뒤 앱으로 돌아오는 주소 (kr.mentalgame.golf://login-callback) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>kr.mentalgame.golf</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kr.mentalgame.golf</string>
			</array>
		</dict>
	</array>
	<!-- 앱이 띄우는 웹 주소 (Config/Base.xcconfig) -->
	<key>MGWebHost</key>
	<string>$(MG_WEB_HOST)</string>
	<!-- 첫 화면: 웹과 같은 바탕색에 글자 로고 -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<!-- 웹 화면이 밝은 색만 있어서 앱도 밝게 고정 -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<!-- 스코어카드 사진으로 기록 추가: 사진 찍기·고르기 -->
	<key>NSCameraUsageDescription</key>
	<string>스코어카드 사진을 찍어 기록을 추가할 때 카메라를 사용해요.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>스코어카드 사진을 골라 기록을 추가할 때 사진 보관함을 사용해요.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>정산 결과 이미지를 사진 보관함에 저장할 때 사용해요.</string>
	<!-- 개발 중 이 Mac 의 테스트 서버(127.0.0.1)에 붙을 수 있게. 다른 인터넷 주소의 보안 규칙은 그대로 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 표준 암호화(HTTPS)만 써서 수출 규정 질문에 '아니요' -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
